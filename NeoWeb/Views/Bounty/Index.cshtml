@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Neo Vulnerability Bounty Program"].Value;
}

<div class="py-5">
    <p>
        @Localizer["Neo is committed to maintaining the security and stability of its blockchain network. We encourage security researchers to responsibly report vulnerabilities affecting Neo N3 and reward eligible findings based on their severity and impact."]
    </p>

    <section class="mt-5">
        <h3>@Localizer["Program Rules"]</h3>
        <ul class="mt-4">
            <li><strong>@Localizer["Local testing only."]</strong> @Localizer["All vulnerability testing and exploitation must be performed in an isolated local network. Testing, exploiting, or attempting to exploit vulnerabilities on Neo MainNet or public TestNet is strictly prohibited."]</li>
            <li><strong>@Localizer["No harm."]</strong> @Localizer["Researchers must not access third-party data or assets, disrupt network operations, or cause damage to users or infrastructure."]</li>
            <li><strong>@Localizer["Responsible disclosure."]</strong> @Localizer["Vulnerabilities must remain confidential and must not be publicly disclosed without prior authorization from Neo."]</li>
            <li><strong>@Localizer["First valid report."]</strong> @Localizer["Only the first eligible report of a previously unknown vulnerability may receive a monetary reward."]</li>
            <li><strong>@Localizer["Related vulnerabilities."]</strong> @Localizer["Multiple findings arising from the same underlying root cause may be treated as a single vulnerability."]</li>
            <li><strong>@Localizer["Final assessment."]</strong> @Localizer["Neo reserves the right to determine eligibility, severity, and reward amounts at its discretion."]</li>
        </ul>
    </section>

    <section class="mt-5">
        <h3>@Localizer["Scope"]</h3>
        <p class="mt-4">@Localizer["The program covers security vulnerabilities affecting supported and actively maintained versions of Neo N3 in the following official repositories:"]</p>
        <ul class="bounty-ul">
            <li><a target="_blank" rel="noopener noreferrer" href="https://github.com/neo-project/neo">neo</a></li>
            <li><a target="_blank" rel="noopener noreferrer" href="https://github.com/neo-project/neo-vm">neo-vm</a></li>
            <li><a target="_blank" rel="noopener noreferrer" href="https://github.com/neo-project/neo-node">neo-node</a></li>
            <li><a target="_blank" rel="noopener noreferrer" href="https://github.com/neo-project/neo-devpack-dotnet">neo-devpack-dotnet</a></li>
        </ul>
        <p>@Localizer["Only vulnerabilities with a demonstrable security impact on Neo N3 are eligible for monetary rewards."]</p>

        <h4 class="mt-4">@Localizer["Out of Scope"]</h4>
        <ul class="mt-3">
            <li>@Localizer["Neo.GUI, websites, third-party applications, smart contracts, and repositories not explicitly listed above."]</li>
            <li>@Localizer["Unsupported, deprecated, or unmaintained versions."]</li>
            <li>@Localizer["Theoretical vulnerabilities, speculative attacks, and findings without a reproducible security impact are not eligible for rewards."]</li>
            <li>@Localizer["Code quality issues, best-practice recommendations, and feature requests."]</li>
            <li>@Localizer["Issues requiring non-default configurations or optional plugins (such as RPC plugin) are automatically classified as Informational or Low severity, unless they also affect a default configuration."]</li>
            <li>@Localizer["Economic, governance, consensus-majority, and Sybil attacks that do not exploit an underlying vulnerability in Neo N3."]</li>
            <li>@Localizer["Differences between the official C# implementation and alternatives, such as neo-go, are classified as informational and are not eligible for rewards."]</li>
            <li>@Localizer["Exposed credentials, API keys, or secrets without evidence of an active security impact."]</li>
            <li>@Localizer["Issues requiring compromised credentials, privileged access, social engineering, or attacks against third-party infrastructure."]</li>
            <li>@Localizer["Previously reported, publicly known, or duplicate vulnerabilities."]</li>
        </ul>
    </section>

    <section class="mt-5">
        <h3>@Localizer["Reporting Vulnerabilities"]</h3>
        <p class="mt-4">
            @Localizer["All vulnerabilities must be reported privately through"]
            <a target="_blank" rel="noopener noreferrer" href="https://github.com/neo-project/neo/security"><strong>@Localizer["Neo GitHub Private Vulnerability Reporting"]</strong></a>,
            @Localizer["using the Report a vulnerability option in the Security tab."]
        </p>
        <p>@Localizer["Each report must include:"]</p>
        <ul class="bounty-ul">
            <li>@Localizer["A clear description of the vulnerability and affected version."]</li>
            <li>@Localizer["Detailed steps to reproduce the issue."]</li>
            <li>@Localizer["A working Proof of Concept (PoC) executed in an isolated local Neo N3 network."]</li>
            <li>@Localizer["Evidence demonstrating the actual security impact."]</li>
            <li>@Localizer["An assessment of the vulnerability's severity."]</li>
        </ul>
        <p><strong>@Localizer["A reproducible PoC in an isolated local network is mandatory for all submissions. Reports without sufficient evidence or demonstrable security impact are not eligible for rewards."]</strong></p>
    </section>

    <section class="mt-5">
        <h3>@Localizer["Rewards"]</h3>
        <p class="mt-4">@Localizer["Eligible vulnerabilities are evaluated by the Neo security team according to their impact, likelihood of exploitation, and overall risk."]</p>
        <table class="mt-4">
            <thead>
                <tr>
                    <th style="width:25%">@Localizer["Severity"]</th>
                    <th style="width:30%">@Localizer["Maximum Reward"]</th>
                    <th style="width:45%">@Localizer["Example"]</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Critical</td><td>$5,000</td><td>@Localizer["Severe loss of assets"]</td></tr>
                <tr><td>High</td><td>$2,500</td><td>@Localizer["Network-wide failure"]</td></tr>
                <tr><td>Medium</td><td>$1,000</td><td>@Localizer["Single-node failure"]</td></tr>
                <tr><td>Low</td><td>$100</td><td>@Localizer["Other valid security issues"]</td></tr>
                <tr><td>Info</td><td>@Localizer["Public Acknowledgment"]</td><td>@Localizer["Findings with no significant security impact"]</td></tr>
            </tbody>
        </table>
        <p class="mt-4">@Localizer["Reward amounts are denominated in USD and paid in the equivalent amount of NEO or GAS."]</p>
        <p>@Localizer["Informational findings are not eligible for monetary rewards but may receive public acknowledgment at Neo's discretion, only after the issue has been resolved or Neo has explicitly authorized its disclosure."]</p>
        <p>@Localizer["Final severity and reward amounts are determined by Neo following technical validation and risk assessment. A valid report does not automatically guarantee a monetary reward."]</p>
    </section>

    <p class="mt-5">@Localizer["We appreciate the contributions of security researchers in helping protect the Neo ecosystem."]</p>
</div>
